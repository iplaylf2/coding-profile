{
    "editor.codeActionsOnSave": {
        "source.sort.json": "explicit"
    },
    "editor.formatOnSave": true,
    "nix.enableLanguageServer": true,
    "nix.serverPath": "nixd",
    "nix.serverSettings": {
        "nixd": {
            "formatting": {
                "command": [
                    "nixfmt"
                ],
            },
        },
    }
}