ARG BASE_IMAGE=quay.io/podman/machine-os:6.1
FROM ${BASE_IMAGE}

RUN dnf --assumeyes \
        --setopt=install_weak_deps=False \
        install toolbox \
    && dnf clean all

COPY zram-generator.conf /usr/lib/systemd/zram-generator.conf
COPY user.slice.d/ /usr/lib/systemd/user/user.slice.d/

RUN systemctl enable systemd-oomd.service \
    && bootc container lint
