FROM registry.fedoraproject.org/fedora-toolbox:latest

LABEL com.github.containers.toolbox="true"

# pnpm's standalone executable requires libatomic on Fedora. Include jq and
# ripgrep as general-purpose tools for structured-data inspection and search.
RUN dnf --assumeyes \
        --setopt=install_weak_deps=False \
        install \
        jq \
        libatomic \
        ripgrep \
    && dnf clean all

COPY --chmod=0755 make-devtool-mutable /usr/local/bin/

ENV DEVTOOLS_HOME=/opt/devtools
ENV PNPM_HOME=${DEVTOOLS_HOME}/pnpm
ENV PATH="${PNPM_HOME}/bin:${PATH}"

RUN install --directory --group=wheel --mode=0775 "${DEVTOOLS_HOME}"

RUN --mount=type=tmpfs,target=/tmp \
    mkdir /tmp/pnpm-home \
    && curl --fail --silent --show-error --location \
        https://get.pnpm.io/install.sh \
        --output /tmp/install-pnpm.sh \
    && HOME=/tmp/pnpm-home SHELL=/bin/bash sh /tmp/install-pnpm.sh \
    && pnpm runtime set node latest --global \
    && make-devtool-mutable "${PNPM_HOME}"

ENV UV_HOME=${DEVTOOLS_HOME}/uv
ENV UV_INSTALL_DIR=${UV_HOME}/libexec
ENV UV_PYTHON_INSTALL_DIR=${UV_HOME}/python
ENV UV_PYTHON_BIN_DIR=${UV_HOME}/bin
ENV PATH="${UV_HOME}/bin:${PATH}"

RUN --mount=type=tmpfs,target=/tmp \
    --mount=type=bind,source=uv-launcher,target=/tmp/uv-launcher,ro \
    curl --fail --silent --show-error --location \
        https://astral.sh/uv/install.sh \
        --output /tmp/install-uv.sh \
    && XDG_CONFIG_HOME="${UV_HOME}/config" \
        UV_NO_MODIFY_PATH=1 \
        sh /tmp/install-uv.sh \
    && mkdir "${UV_HOME}/bin" \
    && install /tmp/uv-launcher "${UV_HOME}/bin/uv" \
    && ln --symbolic ../libexec/uvx "${UV_HOME}/bin/uvx" \
    && UV_CACHE_DIR=/tmp/uv-cache uv python install --default \
    && make-devtool-mutable "${UV_HOME}"
